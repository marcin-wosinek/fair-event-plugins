.DS_Store
.vscode/*
!vendor/autoload.php
!.vscode/launch.json
!.vscode/settings.json
.vscode
# .claude is tracked (hooks, commands, settings.json) — only local state is ignored
.claude/settings.local.json
.claude/scheduled_tasks.lock
vendor/
# Shipped Fair Timetable vendor trees, fixtures for the shared-library loader (#2181)
!e2e/mu-plugins/lib/legacy-shared/*/vendor/

# Plugin dependencies and build artifacts
*/vendor/*
*/node_modules/*
*/build/*
# Generated block documentation (scripts/block-docs.mjs, run by each plugin build)
*/block-docs/
node_modules
dist

# Playwright test results and reports
playwright-report/
test-results/
*/playwright-report/
*/test-results/
*/tests/screenshots/*.png
e2e/screenshots/output/
e2e-results/
api-results/
api-inventory.json
*/.env

# Local deploy config (real values); template `.deploy/example.env` is committed
.deploy/*.env
!.deploy/example.env

# Temporary files
*.tmp
*.log
*.cache

# Release scripts (local SVN checkouts)
*/svn/

# Generated GlotPress-import files (scripts/translation/export-for-wporg.js)
*/languages/wporg-import/
.vim/coc-settings.json
deployment-config.txt
fair-platform-deployment-config.txt
.env

# PHPUnit result cache
.phpunit.cache/

# Duplication reports (npm run duplication)
reports/

# Admin table review example bundle (built by fair-events-shared)
e2e/mu-plugins/admin-table-example/build/
