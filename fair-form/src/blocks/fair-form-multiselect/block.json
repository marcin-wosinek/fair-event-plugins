{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "fair-form/fair-form-multiselect",
	"version": "1.0.0",
	"title": "Multiselect Question",
	"category": "widgets",
	"icon": "yes-alt",
	"description": "A multiple-choice checkbox question for Fair Form",
	"keywords": [
		"question",
		"checkbox",
		"multiselect",
		"multiple",
		"category"
	],
	"textdomain": "fair-form",
	"ancestor": [
		"fair-form/fair-form",
		"fair-audience/event-signup",
		"fair-events/event-signup"
	],
	"supports": {
		"html": false
	},
	"attributes": {
		"questionText": {
			"type": "string",
			"default": ""
		},
		"questionKey": {
			"type": "string",
			"default": ""
		},
		"required": {
			"type": "boolean",
			"default": false
		},
		"optionSource": {
			"type": "string",
			"enum": [ "manual", "categories", "categoryChildren" ],
			"default": "manual"
		},
		"parentCategoryId": {
			"type": "integer",
			"default": 0
		}
	},
	"editorScript": "file:./editor.js",
	"render": "file:./render.php",
	"style": "file:./style-editor.css"
}
