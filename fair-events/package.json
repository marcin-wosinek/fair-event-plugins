{
	"name": "fair-events",
	"version": "2.0.0",
	"description": "Recurring events, venues, calendar blocks, ticket configuration and signup for WordPress. Paid checkout requires Fair Payments Connector.",
	"license": "GPL-3.0-or-later",
	"author": "Marcin Wosinek",
	"type": "module",
	"scripts": {
		"build": "wp-scripts build --config webpack.config.cjs; npm run makejson; npm run block-docs",
		"block-docs": "node ../scripts/block-docs.mjs generate fair-events",
		"clean": "rm -rf build",
		"prebuild": "npm run clean",
		"start": "webpack --mode=development --watch --config webpack.config.cjs",
		"format": "wp-scripts format",
		"composer:install": "composer install",
		"composer:install:prod": "composer install --no-dev",
		"composer:update": "composer update",
		"composer:update:shared": "composer update fair-events/shared",
		"composer:validate": "composer validate --strict",
		"makepot": "wp i18n make-pot . languages/fair-events.pot --exclude=node_modules,vendor,tests,build,svn && node ../scripts/translation/merge-shared-strings.js --plugin=fair-events",
		"makejson": "wp i18n make-json languages ./build/languages --domain=fair-events --pretty-print --no-purge --use-map=build/map.json",
		"makemo": "wp i18n make-mo languages/",
		"updatepo": "wp i18n update-po languages/fair-events.pot languages/",
		"svn:checkout": "svn co https://plugins.svn.wordpress.org/fair-events svn",
		"svn:copy": "cp -r readme.txt block-docs fair-events.php src package* composer* languages CHANGELOG.md svn/trunk; cp assets/* svn/assets",
		"test": "npm-run-all test:js test:php",
		"test:js": "jest",
		"test:php": "node ../scripts/php-test-runner.mjs",
		"test:api": "playwright test src/API/__tests__/",
		"test:e2e": "node ../scripts/workspace-e2e-runner.mjs",
		"screenshots": "playwright test e2e/wordpress-org.spec.js",
		"screenshots:es": "SCREENSHOT_LOCALE=es_ES playwright test e2e/wordpress-org.spec.js",
		"playwright:run": "playwright test --headed",
		"playwright:up": "playwright test --headed --ui"
	},
	"dependencies": {
		"@fortawesome/fontawesome-svg-core": "^7.0.0",
		"@fortawesome/free-brands-svg-icons": "^7.0.0",
		"@fortawesome/free-solid-svg-icons": "^7.0.0",
		"@wordpress/api-fetch": "8.0.0",
		"@wordpress/block-editor": "19.0.0",
		"@wordpress/blocks": "17.0.0",
		"@wordpress/components": "43.0.0",
		"@wordpress/data": "11.0.0",
		"@wordpress/dataviews": "21.0.0",
		"@wordpress/date": "6.0.0",
		"@wordpress/dom-ready": "5.0.0",
		"@wordpress/element": "10.0.0",
		"@wordpress/i18n": "7.0.0",
		"@wordpress/icons": "19.0.0",
		"calendar-link": "^2.11.6",
		"fair-events-shared": "*",
		"html2canvas": "^1.4.1",
		"recharts": "^3.10.1"
	},
	"devDependencies": {
		"@babel/core": "^8.0.7",
		"@babel/preset-env": "^8.0.7",
		"@babel/preset-react": "^8.0.1",
		"@playwright/test": "^1.64.1",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@wordpress/scripts": "37.0.0",
		"babel-jest": "^30.5.2",
		"dotenv": "^18.0.9",
		"jest": "^30.5.2",
		"@wordpress/jest-preset-default": "14.2.0",
		"jest-environment-jsdom": "^30.5.2",
		"webpack-bundle-output": "^1.1.0"
	}
}
