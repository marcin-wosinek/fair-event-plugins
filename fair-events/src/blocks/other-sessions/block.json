{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "fair-events/other-sessions",
	"version": "0.1.0",
	"title": "Other Sessions",
	"category": "widgets",
	"icon": "calendar-alt",
	"description": "List the upcoming sessions of a recurring event, each linking to its own page.",
	"keywords": [ "event", "sessions", "recurring", "series", "dates" ],
	"textdomain": "fair-events",
	"attributes": {
		"maxSessions": {
			"type": "integer",
			"default": 5
		}
	},
	"usesContext": [ "postId", "postType" ],
	"supports": {
		"html": false,
		"anchor": true,
		"align": true
	},
	"editorScript": "file:./editor.js",
	"style": "file:./style-editor.css",
	"render": "file:./render.php"
}
