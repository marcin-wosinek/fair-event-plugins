{
	"permissions": {
		"allow": ["Bash(vendor/bin/phpcs *)"]
	},
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "Edit|Write|MultiEdit|NotebookEdit",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/scripts/agent-hook.mjs\" claude guard"
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "Edit|Write|MultiEdit|NotebookEdit",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/scripts/agent-hook.mjs\" claude format"
					}
				]
			}
		]
	},
	"enabledPlugins": {
		"frontend-design@claude-plugins-official": true
	}
}
