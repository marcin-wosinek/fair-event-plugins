#: src/Core/Features.php:133
msgid "Event feeds"
msgstr "Flux d’événements"

#: src/Core/Features.php:134
msgid "Event feeds with iCal/JSON output, external calendar imports, Facebook import, event proposals."
msgstr "Flux d’événements avec sortie iCal/JSON, import de calendriers externes, import Facebook, propositions d’événements."

#: src/Core/Features.php:137
msgid "Ticketing extensions"
msgstr "Extensions de billetterie"

#: src/Core/Features.php:138
msgid "Group pricing and group permission rules for tickets. Requires Ticketing in the Fair Events features and Fair Audience. Turning this off keeps base ticketing and stored rules."
msgstr "Tarifs et règles d’autorisation par groupe pour les billets. Nécessite Billetterie dans les fonctionnalités de Fair Events ainsi que Fair Audience. La désactivation conserve la billetterie de base et les règles enregistrées."

#: src/Core/Features.php:141
msgid "Mailings"
msgstr "Envois"

#: src/Core/Features.php:142
msgid "Scheduled email mailings for event attendees. Requires fair-audience."
msgstr "Envois d'emails programmés pour les participants à l'événement. Nécessite fair-audience."

#: src/Core/Features.php:145
#: src/Admin/settings/MetaConversions.js:581
msgid "Meta Conversions"
msgstr "Conversions Meta"

#: src/Core/Features.php:146
msgid "Consent-gated server-side Meta checkout and purchase measurement. Requires Fair Payments Connector and explicit credentials."
msgstr "Mesure de paiement et d'achat côté serveur Meta avec consentement. Nécessite Fair Payments Connector et des identifiants explicites."

#: src/Meta/Connector.php:54
msgid "Meta Conversions API"
msgstr "API Meta Conversions"

#: src/Meta/Connector.php:69
msgid "Report consented checkouts, purchases and event-page button clicks to Meta. Removing the access token stops conversion delivery until another token is saved."
msgstr "Signalez les paiements consentis, les achats et les clics sur les boutons de la page d'événement à Meta. La suppression du jeton d'accès arrête la livraison des conversions jusqu'à ce qu'un autre jeton soit enregistré."

#. translators: %s: environment variable name
#: src/Meta/Connector.php:73
#, php-format
msgid "The token in use comes from the %s environment variable, so removing a saved token here does not stop delivery."
msgstr "Le jeton utilisé provient de la variable d'environnement %s, donc la suppression d'un jeton enregistré ici n'arrête pas la livraison."

#. translators: %s: PHP constant name
#: src/Meta/Connector.php:76
#, php-format
msgid "The token in use comes from the %s constant, so removing a saved token here does not stop delivery."
msgstr "Le jeton utilisé provient de la constante %s, donc la suppression d'un jeton enregistré ici n'arrête pas la livraison."

#: src/Meta/Connector.php:93
msgid "Meta access token"
msgstr "Jeton d'accès Meta"

#: src/Meta/Connector.php:94
msgid "Access token for the Meta Conversions API."
msgstr "Jeton d'accès pour l'API Meta Conversions."

#: src/Meta/Connector.php:178
msgid "That does not look like a Meta access token. Paste the full token generated in Events Manager, without spaces. The saved token was not changed."
msgstr "Cela ne ressemble pas à un jeton d'accès Meta. Collez le jeton complet généré dans le Gestionnaire d'événements, sans espaces. Le jeton enregistré n'a pas été modifié."

