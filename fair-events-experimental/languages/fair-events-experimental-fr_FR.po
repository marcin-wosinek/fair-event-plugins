#, php-format
msgid "The connection works: Meta confirmed the account @%s."
msgstr "La connexion fonctionne : Meta a confirmé le compte @%s."

#: src/Instagram/Connection.php:539
msgid "The connection works."
msgstr "La connexion fonctionne."

