msgstr "Configurez l'ID du dataset, le jeton d'accès et le code des événements de test avant d'envoyer un événement de test."

#: src/Admin/settings/MetaConversions.js:454
msgid "Recent delivery outcomes"
msgstr "Résultats de livraison récents"

#: src/Admin/settings/MetaConversions.js:568
msgid "Clear the Meta access token? Conversion delivery will stop until a new token is saved."
msgstr "Effacer le jeton d'accès Meta ? La livraison des conversions s'arrêtera jusqu'à ce qu'un nouveau jeton soit enregistré."

#: src/Admin/settings/MetaConversions.js:73
msgid "Test"
msgstr "Test"

#: src/Admin/settings/MetaConversions.js:74
msgid "Live"
msgstr "En direct"

#: src/Admin/settings/MetaConversions.js:252
