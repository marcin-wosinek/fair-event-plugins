#: src/Admin/compare-events/CompareEventsPage.js:275
msgid "Open event statistics"
msgstr "Otwórz statystyki wydarzenia"

#: src/Admin/compare-events/CompareEventsPage.js:330
msgid "Cumulative tickets sold"
