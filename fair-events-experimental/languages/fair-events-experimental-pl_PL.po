#: src/Core/Features.php:134
msgid "Event feeds with iCal/JSON output, external calendar imports, Facebook import, event proposals."
msgstr "Kanały wydarzeń z wyjściem iCal/JSON, import zewnętrznych kalendarzy, import z Facebooka, propozycje wydarzeń."

#: src/Core/Features.php:137
msgid "Ticketing extensions"
msgstr "Rozszerzenia sprzedaży biletów"

#: src/Core/Features.php:138
msgid "Group pricing and group permission rules for tickets. Requires Ticketing in the Fair Events features and Fair Audience. Turning this off keeps base ticketing and stored rules."
msgstr "Ceny grupowe i reguły uprawnień grup dla biletów. Wymaga włączenia Sprzedaży biletów w funkcjach Fair Events oraz wtyczki Fair Audience. Wyłączenie zachowuje podstawową sprzedaż biletów i zapisane reguły."

#: src/Core/Features.php:141
msgid "Mailings"
msgstr "Wysyłki"

#: src/Core/Features.php:142
msgid "Scheduled email mailings for event attendees. Requires fair-audience."
msgstr "Zaplanowane wysyłki e-mail dla uczestników zdarzenia. Wymaga fair-audience."

