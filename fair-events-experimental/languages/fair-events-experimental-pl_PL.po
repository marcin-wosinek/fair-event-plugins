#: src/Admin/settings/MetaConversions.js:239
msgid "Meta Conversions"
msgstr "Meta Conversions"

#: src/Core/Features.php:155
msgid "Consent-gated server-side Meta checkout and purchase measurement. Requires Fair Payments Connector and explicit credentials."
msgstr "Pomiary kasy i zakupów Meta po stronie serwera z gatekeeper zgody. Wymaga Fair Payments Connector i jawnych poświadczeń."

#: src/Admin/settings/MetaConversions.js:130
msgid "Failed to load Meta Conversions settings."
msgstr "Nie można było wczytać ustawień Meta Conversions."

