msgstr "Token w użyciu pochodzi ze zmiennej środowiskowej %s, dlatego usunięcie zapisanego tokenu tutaj nie zatrzyma dostarczania."

#. translators: %s: PHP constant name
#: src/Meta/Connector.php:76
#, php-format
msgid "The token in use comes from the %s constant, so removing a saved token here does not stop delivery."
msgstr "Token w użyciu pochodzi ze stałej %s, dlatego usunięcie zapisanego tokenu tutaj nie zatrzyma dostarczania."

#: src/Meta/Connector.php:93
msgid "Meta access token"
msgstr "Token dostępu Meta"

