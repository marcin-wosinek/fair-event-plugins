#. Description of the plugin
#: fair-events-experimental.php
msgid "Activates advanced feature bundles for Fair Events, including sources, ticketing, and duplicate and merge tools. Requires fair-events."
msgstr "Activa paquetes de funciones avanzadas para Fair Events, incluyendo fuentes, venta de entradas y herramientas de duplicación y fusión. Requiere fair-events."

#: src/API/WeeklyNotificationsController.php:133
msgid "You do not have permission to manage weekly notifications."
msgstr "No tienes permiso para gestionar notificaciones semanales."

#: src/API/WeeklyNotificationsController.php:147
msgid "Enter the send time as HH:MM, for example 09:00."
msgstr "Introduce la hora de envío en formato HH:MM, por ejemplo 09:00."

#. translators: %s: comma-separated list of the rejected identifiers
#: src/API/WeeklyNotificationsController.php:225
#, php-format
