{
	"name": "fair-event-plugins/fair-events-experimental",
	"description": "Event sources, group pricing, schedule editing, comparisons and optional Meta conversions for Fair Events.",
	"type": "wordpress-plugin",
	"license": "GPL-3.0-or-later",
	"authors": [
		{
			"name": "Marcin Wosinek",
			"email": "marcin.wosinek@gmail.com"
		}
	],
	"repositories": [
		{
			"type": "path",
			"url": "../fair-events-shared/php",
			"options": {
				"symlink": false
			}
		}
	],
	"require": {
		"php": ">=8.0 <9.0",
		"fair-events/shared": "^0.2"
	},
	"config": {
		"platform": {
			"php": "8.0"
		}
	},
	"autoload": {
		"psr-4": {
			"FairEventsExperimental\\": "src/"
		}
	}
}
