#. Description of the plugin
#: fair-audience-experimental.php
msgid "Activates advanced feature bundles for Fair Audience (fees, polls, photos, Instagram, groups, collaborators, messaging, image templates, timeline, import, invitations, manage-event-ext). Requires fair-audience."
msgstr "Włącza zaawansowane pakiety funkcji dla Fair Audience (opłaty, ankiety, zdjęcia, Instagram, grupy, współpracownicy, wiadomości, szablony obrazków, oś czasu, import, zaproszenia, manage-event-ext). Wymaga fair-audience."

#: src/Core/Features.php:197
msgid "Custom mail to the whole audience, extra messages, scheduled messages."
msgstr "Niestandardowa wiadomość e-mail dla całej publiczności, dodatkowe wiadomości, zaplanowane wiadomości."

