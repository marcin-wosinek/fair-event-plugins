#. translators: %s: comma-separated token scopes
#: src/Admin/api-tokens/ApiTokensApp.js:384
#, js-format
msgid "Any site using this token immediately loses access to: %s."
msgstr "Każda witryna używająca tego tokena natychmiast utraci dostęp do: %s."

#: src/Admin/api-tokens/ApiTokensApp.js:392
msgid "The token stays listed as revoked and cannot be reactivated; generate a new token to restore access."
msgstr "Token pozostaje na liście odwołanych i nie może być ponownie aktywowany; wygeneruj nowy token, aby przywrócić dostęp."

#. translators: %s: connected site label
#: src/Admin/connected-sites/ConnectedSitesApp.js:308
#, js-format
msgid "Connected site “%s” removed."
msgstr "Połączona witryna „%s” usunięta."

#: src/Admin/connected-sites/ConnectedSitesApp.js:317
msgid "The connected site could not be removed. Try again."
msgstr "Nie można było usunąć połączonej witryny. Spróbuj ponownie."

