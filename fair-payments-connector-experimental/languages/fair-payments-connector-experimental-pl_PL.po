#. translators: %s: API token label
#: src/Admin/api-tokens/ApiTokensApp.js:137
#, js-format
msgid "API token “%s” revoked."
msgstr "Token API „%s” odwołany."

#: src/Admin/api-tokens/ApiTokensApp.js:146
msgid "The API token could not be revoked. Try again."
msgstr "Nie można było odwołać tokena API. Spróbuj ponownie."

#. translators: %s: API token label
#: src/Admin/api-tokens/ApiTokensApp.js:361
#, js-format
msgid "Revoke API token — %s"
