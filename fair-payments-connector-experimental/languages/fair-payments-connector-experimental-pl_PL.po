#: src/Admin/connected-sites/ConnectedSitesApp.js:655
msgid "Removing…"
msgstr "Usuwanie…"

#. translators: %s: connected site base URL
#: src/Admin/connected-sites/ConnectedSitesApp.js:668
#, js-format
msgid "This site stops reading data from %s, and the token stored for it is deleted here. To add the site again you need its token."
msgstr "Ta witryna przestaje odczytywać dane z %s, a token dla niej przechowywany tutaj jest usuwany. Aby dodać witrynę ponownie, potrzebujesz jej tokena."

#: src/Admin/connected-sites/ConnectedSitesApp.js:676
msgid "Transactions already imported from it are kept. The token is not revoked on the other site; revoke it there if it should stop working."
msgstr "Transakcje już zaimportowane z niej są zachowywane. Token nie jest odwołany na drugiej witrynie; odwołaj go tam, jeśli powinien przestać działać."
