{
	"name": "fair-event-plugins/fair-finance",
	"description": "Budgeting, financial entries, and reconciliation for Fair Event Plugins",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"repositories": [
		{
			"type": "path",
			"url": "../fair-events-shared/php",
			"options": {
				"symlink": false
			}
		}
	],
	"require": {
		"php": "^8.0",
		"fair-events/shared": "^0.2"
	},
	"authors": [
		{
			"name": "Marcin Wosinek",
			"email": "marcin.wosinek@gmail.com"
		}
	],
	"autoload": {
		"psr-4": {
			"FairFinance\\": "src/"
		}
	},
	"config": {
		"platform": {
			"php": "8.0"
		}
	}
}
