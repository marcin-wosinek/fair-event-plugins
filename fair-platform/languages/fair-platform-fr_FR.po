#. Plugin Name of the plugin
#: fair-platform.php
msgid "Fair Platform - Mollie OAuth Integration"
msgstr "Fair Platform - Intégration OAuth Mollie"

#. Description of the plugin
#: fair-platform.php
msgid "Minimal OAuth proxy for Mollie Connect integration. Enables WordPress sites to connect Mollie accounts with platform fees."
msgstr "Proxy OAuth minimal pour l'intégration Mollie Connect. Permet aux sites WordPress de connecter les comptes Mollie avec les frais de plateforme."

