#. Plugin Name of the plugin
#: fair-platform.php
msgid "Fair Platform - Mollie OAuth Integration"
msgstr "Fair Platform - Integración OAuth de Mollie"

#. Description of the plugin
#: fair-platform.php
msgid "Minimal OAuth proxy for Mollie Connect integration. Enables WordPress sites to connect Mollie accounts with platform fees."
msgstr "Proxy OAuth mínimo para la integración de Mollie Connect. Permite que los sitios de WordPress conecten cuentas de Mollie con tarifas de plataforma."

