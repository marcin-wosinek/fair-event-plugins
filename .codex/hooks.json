{
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "^apply_patch$",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$(git rev-parse --show-toplevel)/scripts/agent-hook.mjs\" codex guard"
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "^apply_patch$",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$(git rev-parse --show-toplevel)/scripts/agent-hook.mjs\" codex format"
					}
				]
			}
		]
	}
}
