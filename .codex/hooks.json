{
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "^apply_patch$",
				"hooks": [
					{
						"type": "command",
						"command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/guard-generated-files.sh\""
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "^apply_patch$",
				"hooks": [
					{
						"type": "command",
						"command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/format-edited-file.sh\""
					}
				]
			}
		]
	}
}
