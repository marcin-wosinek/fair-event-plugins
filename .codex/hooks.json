{
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "Edit|Write|MultiEdit|NotebookEdit",
				"hooks": [
					{
						"type": "command",
						"command": "bash '/Users/marcinwosinek/workspace/fair-event-plugins/.codex/hooks/guard-generated-files.sh'"
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "Edit|Write|MultiEdit|NotebookEdit",
				"hooks": [
					{
						"type": "command",
						"command": "bash '/Users/marcinwosinek/workspace/fair-event-plugins/.codex/hooks/format-edited-file.sh'"
					}
				]
			}
		]
	}
}
