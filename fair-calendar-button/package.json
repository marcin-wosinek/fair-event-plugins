{
	"name": "fair-calendar-button",
	"version": "1.5.5",
	"description": "A Gutenberg block for calendar integration",
	"license": "GPL-3.0-or-later",
	"author": "Marcin Wosinek",
	"type": "module",
	"main": "build/index.js",
	"scripts": {
		"build": "wp-scripts build --config webpack.config.cjs; npm run makejson; npm run block-docs",
		"block-docs": "node ../scripts/block-docs.mjs generate fair-calendar-button",
		"clean": "rm -rf build",
		"prebuild": "npm run clean",
		"start": "wp-scripts start --config webpack.config.cjs",
		"composer:install": "composer install",
		"composer:install:prod": "composer install --no-dev",
		"composer:update": "composer update",
		"composer:validate": "composer validate --strict",
		"format": "wp-scripts format",
		"makepot": "wp i18n make-pot . languages/fair-calendar-button.pot --exclude=node_modules,vendor,tests,build,svn",
		"makejson": "wp i18n make-json languages ./build/languages --domain=fair-calendar-button --pretty-print --no-purge --use-map=build/map.json",
		"makemo": "wp i18n make-mo languages/",
		"updatepo": "wp i18n update-po languages/fair-calendar-button.pot languages/",
		"test": "jest",
		"test:js": "jest",
		"test:e2e": "node ../scripts/workspace-e2e-runner.mjs",
		"screenshots": "playwright test e2e/wordpress-org.spec.js",
		"playwright:run": "playwright test --headed",
		"playwright:up": "playwright test --headed --ui",
		"svn:checkout": "svn co https://plugins.svn.wordpress.org/fair-calendar-button svn",
		"svn:copy": "cp -r readme.txt block-docs fair-calendar-button.php src package* composer* languages CHANGELOG.md svn/trunk; cp assets/* svn/assets"
	},
	"dependencies": {
		"@fortawesome/fontawesome-svg-core": "^7.0.0",
		"@fortawesome/free-brands-svg-icons": "^7.0.0",
		"@fortawesome/free-solid-svg-icons": "^7.0.0",
		"@wordpress/api-fetch": "7.57.0",
		"@wordpress/block-editor": "18.1.0",
		"@wordpress/blocks": "16.2.0",
		"@wordpress/components": "42.0.0",
		"@wordpress/i18n": "6.30.0",
		"calendar-link": "^2.11.6",
		"date-fns": "^4.1.0",
		"fair-events-shared": "*"
	},
	"devDependencies": {
		"@babel/core": "^8.0.7",
		"@babel/preset-env": "^8.0.7",
		"@babel/preset-react": "^8.0.1",
		"@playwright/test": "^1.64.1",
		"@testing-library/react": "^16.3.3",
		"@wordpress/jest-preset-default": "14.2.0",
		"@wordpress/scripts": "36.1.0",
		"babel-jest": "^30.5.2",
		"dotenv": "^17.2.3",
		"jest": "^30.5.2",
		"jest-environment-jsdom": "^30.5.2",
		"webpack-bundle-output": "^1.1.0"
	}
}
