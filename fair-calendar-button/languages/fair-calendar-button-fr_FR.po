#. Plugin Name of the plugin
#: fair-calendar-button.php
msgid "Fair Calendar Button"
msgstr "Bouton de Calendrier"

#. Plugin URI of the plugin
#: fair-calendar-button.php
msgid "https://wordpress.org/plugins/fair-calendar-button/"
msgstr ""

#. Description of the plugin
#: fair-calendar-button.php
msgid "A Gutenberg block for calendar integration. The block displays a button with a calendar integration with support for Google Calendar, Outlook, Yahoo Calendar, and ICS downloads."
msgstr "Un bloc Gutenberg pour l'intégration de calendrier. Le bloc affiche un bouton avec intégration de calendrier compatible avec Google Calendar, Outlook, Yahoo Calendar et téléchargements ICS."

