#. Plugin Name of the plugin
#: fair-calendar-button.php
msgid "Fair Calendar Button"
msgstr "Przycisk Kalendarza"

#. Plugin URI of the plugin
#: fair-calendar-button.php
msgid "https://wordpress.org/plugins/fair-calendar-button/"
msgstr "https://wordpress.org/plugins/fair-calendar-button/"

#. Description of the plugin
#: fair-calendar-button.php
msgid "A Gutenberg block for calendar integration. The block displays a button with a calendar integration with support for Google Calendar, Outlook, Yahoo Calendar, and ICS downloads."
msgstr "Blok Gutenberga do integracji z kalendarzem. Blok wyświetla przycisk z integracją kalendarza z obsługą Kalendarza Google, Outlook, Yahoo Calendar i pobieraniem plików ICS."

#. Author of the plugin
#: fair-calendar-button.php
msgid "Marcin Wosinek"
msgstr "Marcin Wosinek"

#. Author URI of the plugin
#: fair-calendar-button.php
msgid "https://github.com/marcin-wosinek"
msgstr "https://github.com/marcin-wosinek"

