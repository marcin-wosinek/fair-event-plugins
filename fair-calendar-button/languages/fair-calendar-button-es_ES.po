#. Plugin Name of the plugin
#: fair-calendar-button.php
msgid "Fair Calendar Button"
msgstr "Botón de Calendario"

#. Plugin URI of the plugin
#: fair-calendar-button.php
msgid "https://wordpress.org/plugins/fair-calendar-button/"
msgstr ""

#. Description of the plugin
#: fair-calendar-button.php
msgid "A Gutenberg block for calendar integration. The block displays a button with a calendar integration with support for Google Calendar, Outlook, Yahoo Calendar, and ICS downloads."
msgstr "Un bloque de Gutenberg para integración de calendario. El bloque muestra un botón con integración de calendario compatible con Google Calendar, Outlook, Yahoo Calendar y descargas ICS."

