{
	"name": "fair-payments-connector",
	"version": "2.6.0",
	"description": "Simple payment block for WordPress",
	"main": "build/index.js",
	"scripts": {
		"composer:install": "composer install",
		"composer:install:prod": "composer install --no-dev",
		"composer:update": "composer update",
		"composer:update:shared": "composer update fair-events/shared",
		"composer:validate": "composer validate --strict",
		"prebuild": "npm run clean",
		"build": "webpack --mode=production --config webpack.config.cjs; npm run makejson; npm run block-docs",
		"block-docs": "node ../scripts/block-docs.mjs generate fair-payments-connector",
		"clean": "rm -rf build",
		"start": "webpack --mode=development --watch --config webpack.config.cjs",
		"format": "wp-scripts format",
		"test": "npm-run-all test:js test:php",
		"test:js": "jest",
		"test:api": "playwright test",
		"test:php": "node ../scripts/php-test-runner.mjs",
		"makepot": "wp i18n make-pot . languages/fair-payments-connector.pot --exclude=node_modules,vendor,tests,build,svn && node ../scripts/translation/merge-shared-strings.js --plugin=fair-payments-connector",
		"makejson": "wp i18n make-json languages ./build/languages --domain=fair-payments-connector --pretty-print --no-purge --use-map=build/map.json",
		"makemo": "wp i18n make-mo languages/",
		"updatepo": "wp i18n update-po languages/fair-payments-connector.pot languages/",
		"svn:checkout": "svn co https://plugins.svn.wordpress.org/fair-payments-connector svn",
		"svn:copy": "cp -r readme.txt block-docs fair-payments-connector.php src package* composer* languages CHANGELOG.md svn/trunk"
	},
	"keywords": [
		"wordpress",
		"gutenberg",
		"block",
		"payment"
	],
	"author": "Fair Event Plugins",
	"license": "GPL-2.0-or-later",
	"devDependencies": {
		"@babel/core": "^8.0.7",
		"@babel/preset-env": "^8.0.7",
		"@babel/preset-react": "^8.0.1",
		"@playwright/test": "^1.64.1",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@wordpress/scripts": "37.0.0",
		"babel-jest": "^30.5.2",
		"@wordpress/jest-preset-default": "14.2.0",
		"dotenv": "^18.0.9",
		"jest": "^30.5.2",
		"jest-environment-jsdom": "^30.5.2",
		"webpack-bundle-output": "^1.1.0"
	},
	"dependencies": {
		"@wordpress/api-fetch": "8.0.0",
		"@wordpress/block-editor": "19.0.0",
		"@wordpress/blocks": "17.0.0",
		"@wordpress/components": "43.0.0",
		"@wordpress/dom-ready": "5.0.0",
		"@wordpress/element": "9.0.0",
		"@wordpress/i18n": "7.0.0",
		"fair-events-shared": "*"
	}
}
