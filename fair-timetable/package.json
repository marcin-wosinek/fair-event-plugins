{
	"name": "fair-timetable",
	"version": "0.8.0",
	"description": "Fair Timetable WordPress plugin",
	"license": "GPL-3.0-or-later",
	"author": "Marcin Wosinek",
	"type": "module",
	"main": "build/index.js",
	"scripts": {
		"build": "wp-scripts build --config webpack.config.cjs; npm run makejson; npm run block-docs",
		"block-docs": "node ../scripts/block-docs.mjs generate fair-timetable",
		"clean": "rm -rf build",
		"prebuild": "npm run clean",
		"start": "webpack --mode=development --watch --config webpack.config.cjs",
		"format": "wp-scripts format",
		"makepot": "wp i18n make-pot . languages/fair-timetable.pot --exclude=node_modules,vendor,tests,build,svn",
		"makejson": "wp i18n make-json languages ./build/languages --domain=fair-timetable --pretty-print --no-purge --use-map=build/map.json",
		"makemo": "wp i18n make-mo languages/",
		"updatepo": "wp i18n update-po languages/fair-timetable.pot languages/",
		"composer:install": "composer install",
		"composer:install:prod": "composer install --no-dev",
		"composer:update": "composer update",
		"composer:update:shared": "composer update fair-events/shared",
		"composer:validate": "composer validate --strict",
		"test": "npm-run-all test:js test:php",
		"test:js": "jest",
		"test:php": "node ../scripts/php-test-runner.mjs",
		"test:e2e": "node ../scripts/workspace-e2e-runner.mjs",
		"screenshots": "playwright test e2e/wordpress-org.spec.js",
		"playwright:run": "playwright test --headed",
		"playwright:up": "playwright test --headed --ui",
		"svn:checkout": "svn co https://plugins.svn.wordpress.org/fair-timetable svn",
		"svn:copy": "cp -r readme.txt block-docs fair-timetable.php src package* composer* languages CHANGELOG.md svn/trunk; cp assets/* svn/assets"
	},
	"dependencies": {
		"@fortawesome/fontawesome-free": "^7.0.0",
		"@fortawesome/fontawesome-svg-core": "^7.0.0",
		"@fortawesome/free-solid-svg-icons": "^7.0.0",
		"@fortawesome/react-fontawesome": "^3.3.1",
		"@wordpress/block-editor": "18.1.0",
		"@wordpress/blocks": "16.2.0",
		"@wordpress/components": "42.0.0",
		"@wordpress/i18n": "6.30.0",
		"date-fns": "^4.4.0"
	},
	"devDependencies": {
		"@babel/core": "^8.0.7",
		"@babel/preset-env": "^8.0.7",
		"@playwright/test": "^1.64.1",
		"@wordpress/scripts": "37.0.0",
		"babel-jest": "^30.5.2",
		"dotenv": "^18.0.8",
		"jest": "^30.5.2",
		"jest-environment-node": "^30.5.2",
		"webpack-bundle-output": "^1.1.0"
	}
}
